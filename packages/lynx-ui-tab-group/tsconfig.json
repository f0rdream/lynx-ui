{
  "compilerOptions": {
    "jsx": "preserve",
    "lib": [
      "ESNext",
    ],
    "strictNullChecks": true,
    "verbatimModuleSyntax": true,
    "target": "ESNext",
    "declaration": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist/types",
    "types": ["@lynx-js/types"],
    "rootDir": "./src",
  },
  "include": [
    "src",
  ],
}
